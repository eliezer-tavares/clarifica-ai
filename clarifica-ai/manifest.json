{
  "manifest_version": 3,
  "name": "Clarifica.ai",
  "version": "2.0.0",
  "default_locale": "pt_BR",
  "description": "Acessibilidade universal com Edge AI: perguntas e respostas, resumos em português, descrição de imagens, legendas ao vivo, transcrição, OCR, tradução e auditoria WCAG, 100% offline.",
  "author": { "email": "contact@eliezertavaresdeoliveira.com" },
  "homepage_url": "https://github.com/eliezer-tavares/clarifica-ai",
  "minimum_chrome_version": "116",
  "icons": { "128": "assets/icon.png" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "128": "assets/icon.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-resumo": { "suggested_key": { "default": "Ctrl+Shift+R" }, "description": "Resumir página com IA" },
    "toggle-leitura": { "suggested_key": { "default": "Ctrl+Shift+L" }, "description": "Modo Leitura Essencial (NVDA/JAWS)" },
    "toggle-imagens": { "suggested_key": { "default": "Ctrl+Shift+A" }, "description": "Descrever imagens da página" },
    "toggle-reset": { "suggested_key": { "default": "Ctrl+Shift+X" }, "description": "Restaurar página original" },
    "traduzir-selecao": { "description": "Traduzir o trecho selecionado (EN → PT)" }
  },
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["scripts/ai-worker.js", "vendor/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
